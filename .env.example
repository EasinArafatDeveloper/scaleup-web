# Domain & Site Configuration
NEXT_PUBLIC_SITE_URL=https://scaleupweb.xyz

# Hosting (docker-compose.yml) — see DEPLOY.md
# Search engine verification codes (only the code, not the whole meta tag). Rebuild after changing.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
NEXT_PUBLIC_WHATSAPP_NUMBER=8801645650504

# Website form leads → ScaleUp Admin (same INBOUND_SECRET as ~/apps/scaleup-admin/.env)
ADMIN_INBOUND_URL=http://scaleup-admin:3000/api/inbound/lead
INBOUND_SECRET=

# Email & Leads Notifications
CONTACT_EMAIL=hello@scaleupweb.xyz
RESEND_API_KEY=re_your_resend_api_key_here
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/scaleup-leads

# Meta Ads Tracking (Pixel + Server-Side CAPI)
NEXT_PUBLIC_META_PIXEL_ID=1234567890123456
META_CAPI_TOKEN=EAA...your_meta_system_user_token_here

# Analytics & User Session Recording
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=your_clarity_project_id

# Optional AI Chatbot Live API Key
AI_API_KEY=sk-...
